#!/bin/bash
# Control the Discord VC bar widget's daemon.
#
#   omarchy-discord-vc install     install + enable the user service
#   omarchy-discord-vc auth        authorize against Discord (one time)
#   omarchy-discord-vc start|stop|restart|status|log
#   omarchy-discord-vc state       dump the current published state
#   omarchy-discord-vc run         run the daemon in the foreground (debugging)
#   omarchy-discord-vc uninstall   stop and remove the service
#
# No sudo or pkexec is required: everything lives under $HOME.

set -euo pipefail

# Resolve the plugin directory from this script's own location rather than
# assuming an install path. The script works from the plugin checkout, from a
# symlink in ~/.local/bin, and from anywhere else it is called.
SELF="${BASH_SOURCE[0]}"
while [[ -L "$SELF" ]]; do
  target="$(readlink "$SELF")"
  [[ "$target" == /* ]] && SELF="$target" || SELF="$(dirname "$SELF")/$target"
done
PLUGIN_DIR="$(cd "$(dirname "$SELF")/.." && pwd)"

DAEMON_DIR="$PLUGIN_DIR/daemon"
UNIT="omarchy-discord-vc"
UNIT_DIR="$HOME/.config/systemd/user"
RUNTIME="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
STATE_FILE="$RUNTIME/omarchy-discord-vc.json"

die() { echo "omarchy-discord-vc: $*" >&2; exit 1; }

[[ -d "$DAEMON_DIR" ]] || die "daemon not found at $DAEMON_DIR"

# Discord's local RPC socket is the only thing that actually matters, and
# looking for it covers every packaging of the client -- native, Flatpak,
# Snap, Vesktop, canary and PTB -- which a process-name check does not.
discord_socket_present() {
  local root
  # Same locations the daemon trusts -- never world-writable /tmp.
  for root in "$RUNTIME" "$RUNTIME/app/com.discordapp.Discord" \
              "$RUNTIME/snap.discord"; do
    for i in {0..9}; do
      [[ -S "$root/discord-ipc-$i" ]] && return 0
    done
  done
  return 1
}

cmd="${1:-status}"
shift || true

case "$cmd" in
  auth)
    # The authorization prompt appears inside Discord, so it has to be up.
    discord_socket_present \
      || die "no Discord IPC socket found -- is the Discord desktop client running?"
    python3 "$DAEMON_DIR/auth.py" "$@"
    # Pick the new token up immediately if the service is already running.
    if systemctl --user is-active --quiet "$UNIT"; then
      systemctl --user restart "$UNIT"
    fi
    ;;

  install)
    command -v python3 >/dev/null || die "python3 is required but not installed"
    mkdir -p "$UNIT_DIR"
    cat > "$UNIT_DIR/$UNIT.service" <<EOF
[Unit]
Description=Discord voice state publisher for the Omarchy bar
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/env python3 $DAEMON_DIR/daemon.py
Restart=always
RestartSec=3
# The daemon only reads Discord's RPC socket and writes one runtime file.
NoNewPrivileges=yes
PrivateTmp=no

[Install]
WantedBy=graphical-session.target
EOF
    systemctl --user daemon-reload
    systemctl --user enable --now "$UNIT"
    echo "installed and started $UNIT"
    echo
    echo "Next: omarchy-discord-vc auth"
    ;;

  uninstall)
    systemctl --user disable --now "$UNIT" 2>/dev/null || true
    rm -f "$UNIT_DIR/$UNIT.service"
    systemctl --user daemon-reload
    rm -f "$STATE_FILE"
    echo "removed $UNIT"
    echo "the access token is still at ${XDG_STATE_HOME:-$HOME/.local/state}/omarchy-discord-vc/"
    echo "delete that directory to revoke it locally, and remove the app at"
    echo "https://discord.com/settings/authorized-apps to revoke it at Discord"
    ;;

  start|stop|restart)
    systemctl --user "$cmd" "$UNIT"
    ;;

  status)
    systemctl --user status "$UNIT" --no-pager || true
    ;;

  log)
    journalctl --user -u "$UNIT" -n "${1:-50}" --no-pager
    ;;

  state)
    [[ -f "$STATE_FILE" ]] || die "no state file at $STATE_FILE"
    python3 -m json.tool "$STATE_FILE"
    ;;

  run)
    exec python3 "$DAEMON_DIR/daemon.py"
    ;;

  *)
    sed -n '2,12p' "$SELF" | sed 's/^# \{0,1\}//'
    ;;
esac
